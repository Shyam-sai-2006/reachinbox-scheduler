{
  "name": "@reachinbox/api",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy || prisma db push",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@reachinbox/shared": "*",
    "@prisma/client": "^5.11.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "cookie-parser": "^1.4.6",
    "multer": "^1.4.5-lts.1",
    "bullmq": "^5.4.1",
    "ioredis": "^5.3.2",
    "@bull-board/express": "^5.15.3",
    "@bull-board/api": "^5.15.3",
    "@elastic/elasticsearch": "^8.13.0",
    "nodemailer": "^6.9.13",
    "zod": "^3.22.4",
    "dotenv": "^16.4.5",
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^6.4.14",
    "@types/cookie-parser": "^1.4.7",
    "prisma": "^5.11.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}
