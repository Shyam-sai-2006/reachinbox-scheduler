# Environment Configuration for ReachInbox / Outbox Labs Scheduler

# Runtime
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# Queue & Cache (Redis)
REDIS_URL="redis://localhost:6379"

# Search (Elasticsearch)
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Google OAuth 2.0
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Slack OAuth 2.0 (Incoming Webhook integration)
# Obtain from api.slack.com/apps -> OAuth & Permissions -> Add incoming-webhook scope
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"
SLACK_REDIRECT_URI="http://localhost:4000/api/integrations/slack/callback"

# Security & Session
SESSION_SECRET="super-secret-session-key-change-in-production-min-32-chars"
# 32-byte hex key for AES-256-GCM encryption of sensitive database fields (tokens, passwords)
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Multiple Ethereal Senders Configuration (JSON array of SMTP credentials)
# Auto-created via Ethereal during demo/dev or supplied by evaluator
ETHEREAL_SENDERS_JSON='[{"email":"sender1@ethereal.email","displayName":"Sender Alpha","host":"smtp.ethereal.email","port":587,"secure":false,"user":"sender1@ethereal.email","pass":"ethereal_pass_1"},{"email":"sender2@ethereal.email","displayName":"Sender Beta","host":"smtp.ethereal.email","port":587,"secure":false,"user":"sender2@ethereal.email","pass":"ethereal_pass_2"}]'

# Worker Concurrency & Rate Limiting
WORKER_CONCURRENCY=10
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# SMTP Network Timeouts (milliseconds)
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=10000

# Bull Board Dashboard Authentication
BULL_BOARD_USER="admin"
BULL_BOARD_PASSWORD="admin_secure_password"

# File Upload Limit
MAX_UPLOAD_MB=10
