# =================================================================
# ReachInbox Production Environment Configuration
# =================================================================

# Domain / Public URL
# Set to your domain or server IP (e.g. http://your-domain.com or http://123.45.67.89)
FRONTEND_URL=http://localhost
PORT=80

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=reachinbox_user
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
POSTGRES_DB=reachinbox

# Security Keys
# SESSION_SECRET: Minimum 32-character random string
SESSION_SECRET=replace_with_a_random_32_character_secret_key_string
# APP_ENCRYPTION_KEY: 32-byte (64 hex characters) AES-256-GCM key
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 (Optional - Can also use Email/Password or Demo Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# Slack Alerts & OAuth (Optional - Can also be set in Web UI)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost/api/slack/callback
SLACK_WEBHOOK_URL=

# Bull Board Queue Dashboard Credentials
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin_secure_password

# Worker Concurrency & Rate Limiting
WORKER_CONCURRENCY=10
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
